    <string name="settings_automix_length_auto">균형</string>
    <string name="settings_automix_length_long">길게</string>
    <string name="settings_automix_tempo">템포 맞추기</string>
    <string name="settings_automix_tempo_detail">비트를 맞추기 위해 다음 곡의 템포를 얼마나 바꿀 수 있는지 정합니다. 이 범위를 넘으면 필터 페이드로 전환됩니다. 다음 곡이 베이스 없이 들어오고, 다음 곡의 다운비트에서 베이스가 넘어옵니다.</string>
    <string name="settings_automix_tempo_strict">엄격(4%)</string>
    <string name="settings_automix_tempo_normal">보통(12%)</string>
    <string name="settings_automix_tempo_wide">넓게(16%)</string>
    <string name="settings_automix_eq">DJ EQ</string>
    <string name="settings_automix_eq_detail">믹스하는 동안 베이스 스왑과 필터를 적용합니다. 끄면 음량만 바뀝니다.</string>
    <string name="settings_automix_pulse">플레이어 애니메이션</string>
